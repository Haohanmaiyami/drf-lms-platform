SECRET_KEY=your-secret-key
DEBUG=True

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0


# AWS / Speaking audio
AWS_REGION=us-east-1
AWS_S3_SPEAKING_BUCKET=
AWS_S3_PRESIGNED_EXPIRES=900
SPEAKING_MAX_AUDIO_SIZE_BYTES=20971520

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=


# AWS / Speaking transcription
AWS_TRANSCRIBE_LANGUAGE_CODE=en-US
AWS_TRANSCRIBE_OUTPUT_PREFIX=transcriptions
AWS_TRANSCRIBE_POLL_SECONDS=5
AWS_TRANSCRIBE_MAX_POLLS=120

# AWS / Speaking feedback
AWS_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
AWS_BEDROCK_MAX_TOKENS=2500
AWS_BEDROCK_TEMPERATURE=0
AWS_BEDROCK_VALIDATION_RETRIES=1